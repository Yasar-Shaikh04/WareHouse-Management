# Frontend API base URL.
# Set this to the Render BACKEND ORIGIN ONLY — do NOT append /api/v1.
# The app appends /api/v1 itself, so a trailing slash here would cause a
# malformed double-slash request path.
#
# Local development (backend running on http://localhost:5000):
VITE_API_URL=http://localhost:5000
#
# Production (Vercel build → set this value in the Vercel project env vars):
# VITE_API_URL=https://your-render-service.onrender.com
